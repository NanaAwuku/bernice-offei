# Live domain, used for Open Graph / social preview URLs
NEXT_PUBLIC_SITE_URL=https://example.com

# Donate popup checkout link (UAT: https://checkoutuat.itcsrvc.com/transflow-checkout/...)
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.itcsrvc.com/transflow-checkout/IngBrownMatthewOppong

# Who the page remembers
NEXT_PUBLIC_NAME=Brown Matthew Oppong
NEXT_PUBLIC_SHORT_NAME=Matthew Oppong
NEXT_PUBLIC_BIRTH_YEAR=1945
NEXT_PUBLIC_DEATH_YEAR=2026

# Path under /public (e.g. /images/portrait.jpg) or a full https:// image URL (JPEG/PNG)
NEXT_PUBLIC_PORTRAIT=/images/matthew_opp.jpeg

# Quote under the name (shown in quotation marks)
NEXT_PUBLIC_QUOTE="I have fought a good fight, I have finished the race, I have kept the faith."

# "Expressions of sympathy" text; separate paragraphs with ||
NEXT_PUBLIC_SYMPATHY_MESSAGE="We are grateful for the prayers, messages and memories shared in honour of Matthew. Your love and presence mean so much to the family.|| For those who have asked about making a personal donation, the option is available below."

# Optional: search/share description and the line on the link-preview image
NEXT_PUBLIC_DESCRIPTION="Celebrating the life of Brown Matthew Oppong. Honour his memory with a donation to support the family."
NEXT_PUBLIC_TAGLINE="Son, brother, father — forever in our hearts."

# Thank-you / payment-failed pages
NEXT_PUBLIC_RESULT_QUOTE="Remember your Creator while you have breath."
NEXT_PUBLIC_RESULT_QUOTE_SOURCE="Brown Matthew Oppong · “Forever in Our Hearts”"
# NEXT_PUBLIC_MEMORIAL_URL=https://www.forevermissed.com/bernice-offei/about
