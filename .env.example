# Live domain, used for canonical and Open Graph / social preview URLs
# (defaults to siteUrl in src/content/site.json)
NEXT_PUBLIC_SITE_URL=https://www.berniceoffei.com

# REQUIRED. Donation checkout link ("Give online"). The build stops if it is missing.
# Live: https://checkout.itcsrvc.com/transflow-checkout/bernice-offei
# UAT:  https://checkoutuat.itcsrvc.com/transflow-checkout/...
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.itcsrvc.com/transflow-checkout/bernice-offei

# Hosts where "Give online" opens the checkout inside the Donate panel; elsewhere it
# opens in a new tab. The provider only allows framing on www.berniceoffei.com.
# Comma separated; "*" for any host. Defaults to donationEmbedHosts in site.json.
# NEXT_PUBLIC_DONATION_EMBED_HOSTS=www.berniceoffei.com,localhost
