# Live domain, used for Open Graph / social preview URLs
NEXT_PUBLIC_SITE_URL=https://example.com

# Donate popup checkout link (UAT: https://checkoutuat.itcsrvc.com/transflow-checkout/...)
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.itcsrvc.com/transflow-checkout/bernice-offei

# Who the page remembers
NEXT_PUBLIC_NAME=Bernice Ofeibea Offei
NEXT_PUBLIC_SHORT_NAME=Bernice
NEXT_PUBLIC_BIRTH_YEAR=1963
NEXT_PUBLIC_DEATH_YEAR=2026

# Path under /public (e.g. /images/portrait.jpg) or a full https:// image URL (JPEG/PNG)
NEXT_PUBLIC_PORTRAIT=/images/portrait.jpg

# Quote under the name (shown in quotation marks)
NEXT_PUBLIC_QUOTE="Let the memory of our sister, mother and wife, Bernice, be with us forever."

# "Expressions of sympathy" text; separate paragraphs with ||
NEXT_PUBLIC_SYMPATHY_MESSAGE="We are grateful for the prayers, messages and memories shared in honour of Bernice. Your love and presence mean so much to the family.||For those who have asked about making a personal donation, the option is available below."

# Optional: search/share description and the line on the link-preview image
NEXT_PUBLIC_DESCRIPTION="Celebrating the life of Bernice Ofeibea Offei. Honour her memory with a donation to support the family."
NEXT_PUBLIC_TAGLINE="Sister, mother, wife — forever in our hearts."

# Thank-you / payment-failed pages
NEXT_PUBLIC_RESULT_QUOTE="Remember your Creator while you have breath."
NEXT_PUBLIC_RESULT_QUOTE_SOURCE="Bernice Offei · “Life is Short”"
NEXT_PUBLIC_MEMORIAL_URL=https://www.forevermissed.com/bernice-offei/about
